# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gemini-3-flash-preview

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/integration_hub.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/dbname

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
OPERATOR_USERNAME=operator
# Generate with: python -m backend.security.passwords
OPERATOR_PASSWORD_HASH=paste-the-generated-pbkdf2-hash-here
SESSION_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-bytes
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:3000

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=8001

# Integration Credentials

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_PUBLIC_KEY=your-discord-application-public-key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret-key
WEBHOOK_BASE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

